    <ProjectReference Include="../../src/Domain/Domain.csproj" />
    <ProjectReference Include="../../src/CatalogJson/CatalogJson.csproj" />
    <None Include="../../docs/examples/base-rooms.json" Link="base-rooms.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
